#!name=Duolingo Ad Block
#!desc=Blocks third-party in-app ad networks used by Duolingo (AdMob, AppLovin, Unity, ironSource, Meta, etc.)
#!system=ios

[Rule]
# Google AdMob / DoubleClick
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadsserving.cn,REJECT
DOMAIN-SUFFIX,admob.com,REJECT
DOMAIN-KEYWORD,pagead,REJECT

# AppLovin
DOMAIN-SUFFIX,applovin.com,REJECT
DOMAIN-SUFFIX,applvn.com,REJECT

# Unity Ads
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT

# ironSource / Supersonic
DOMAIN-SUFFIX,ironsrc.com,REJECT
DOMAIN-SUFFIX,supersonicads.com,REJECT

# Vungle / Liftoff
DOMAIN-SUFFIX,vungle.com,REJECT
DOMAIN-SUFFIX,liftoff.io,REJECT

# Meta Audience Network (avoids blocking graph.facebook.com so FB login still works)
DOMAIN-SUFFIX,an.facebook.com,REJECT
DOMAIN-SUFFIX,ads.facebook.com,REJECT

# Other common mobile ad networks
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,rayjump.com,REJECT
DOMAIN-SUFFIX,inmobi.com,REJECT
DOMAIN-SUFFIX,chartboost.com,REJECT
DOMAIN-SUFFIX,pangle-global.com,REJECT
DOMAIN-SUFFIX,adcolony.com,REJECT
DOMAIN-SUFFIX,fyber.com,REJECT
DOMAIN-SUFFIX,inner-active.mobi,REJECT

# Duolingo Ad / Telemetry endpoints (safe to block without breaking lessons)
DOMAIN-SUFFIX,ads.duolingo.com,REJECT
DOMAIN-SUFFIX,metrics.duolingo.com,REJECT
